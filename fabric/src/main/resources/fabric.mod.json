{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["net.styna.stynastmc.fabric.StynaSTMCFabric"],
    "client": ["net.styna.stynastmc.fabric.StynaSTMCFabricClient"],
    "modmenu": ["net.styna.stynastmc.fabric.StynaSTMCModMenu"]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fonts.mixins.json",
    "${mod_id}.skins.mixins.json",
    "${mod_id}.zoom.mixins.json",
    "${mod_id}.muffler.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.classtweaker",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}
